cabal-version: 3.0
name: aya
version: 0.1.0.0
synopsis: A local generative and microtonal composition studio
license: MIT
license-file: LICENSE
author: Masaya Shirasawa and contributors
maintainer: https://github.com/M-simplifier/aya-daw/issues
homepage: https://m-simplifier.github.io/aya-daw/
bug-reports: https://github.com/M-simplifier/aya-daw/issues
category: Sound
description: A Windows composition studio with a pure musical compiler, native GHC audio,
             generative patterns, continuous pitch, embedded samples, and offline WAV rendering.
tested-with: GHC == 9.14.1
build-type: Simple

source-repository head
  type: git
  location: https://github.com/M-simplifier/aya-daw.git

common shared
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends: base >=4.22 && <4.23, aeson >=2.2 && <2.3,
    text >=2.1 && <2.2, bytestring >=0.12 && <0.13, containers >=0.8 && <0.9,
    scientific >=0.3 && <0.4, vector >=0.13 && <0.14, binary >=0.8 && <0.9,
    base64-bytestring >=1.2 && <1.3, aya-audio ==0.1.0.0

library
  import: shared
  hs-source-dirs: src
  exposed-modules: Aya.Project, Aya.Compile, Aya.Example, Aya.EnginePlan, Aya.Midi

executable aya
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
  build-depends: aya ==0.1.0.0, wai >=3.2 && <3.3, warp >=3.4.16 && <3.5,
    http-types >=0.12 && <0.13, network >=3.2 && <3.3, directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6, time >=1.14 && <1.16, process >=1.6 && <1.7

test-suite model-tests
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: tests/model
  main-is: Main.hs
  build-depends: aya ==0.1.0.0, QuickCheck >=2.18 && <2.20,
    directory >=1.3 && <1.4, filepath >=1.5 && <1.6
