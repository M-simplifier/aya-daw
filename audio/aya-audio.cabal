cabal-version: 3.0
name: aya-audio
version: 0.1.0.0
build-type: Simple
license: MIT
license-file: LICENSE
author: Masaya Shirasawa and contributors
maintainer: https://github.com/M-simplifier/aya-daw/issues
homepage: https://m-simplifier.github.io/aya-daw/
bug-reports: https://github.com/M-simplifier/aya-daw/issues
category: Sound
description: Native Haskell sample processing, deterministic rendering, and isolated WASAPI transport.
tested-with: GHC == 9.14.1
synopsis: Native GHC synthesis, deterministic rendering and isolated WASAPI transport

source-repository head
  type: git
  location: https://github.com/M-simplifier/aya-daw.git
  subdir: audio

library
  hs-source-dirs: .
  exposed-modules: Aya.Audio, Aya.Audio.Types
  other-modules:
    Aya.Audio.Plan
    Aya.Audio.Kernel
    Aya.Audio.Native
    Aya.Audio.Wave
    Aya.Audio.Reference
    Aya.Audio.Layout
    Aya.Audio.Diagnostics
  build-depends:
    base >=4.22 && <4.23,
    bytestring >=0.12 && <0.13,
    containers >=0.8 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    text >=2.1 && <2.2,
    time >=1.14 && <1.16,
    vector >=0.13 && <0.14
  default-language: GHC2021
  ghc-options: -Wall
  c-sources: cbits/aya_native.c
  cc-options: -D_WIN32_WINNT=0x0A00
  extra-libraries: ole32, uuid, avrt, winmm

test-suite audio-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  build-depends: base >=4.22 && <4.23, aya-audio ==0.1.0.0,
    text >=2.1 && <2.2, vector >=0.13 && <0.14
  default-language: GHC2021
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
